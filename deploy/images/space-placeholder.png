<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <!-- Deep space background gradient -->
  <defs>
    <linearGradient id="spaceGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0e27;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1a1f3a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2d1b4e;stop-opacity:1" />
    </linearGradient>
    
    <radialGradient id="glowGradient" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#8b5cf6;stop-opacity:0.3" />
      <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:0" />
    </radialGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="url(#spaceGradient)"/>
  
  <!-- Stars -->
  <circle cx="100" cy="80" r="1.5" fill="white" opacity="0.8"/>
  <circle cx="250" cy="120" r="1" fill="white" opacity="0.6"/>
  <circle cx="400" cy="90" r="1.2" fill="white" opacity="0.7"/>
  <circle cx="600" cy="140" r="0.8" fill="white" opacity="0.5"/>
  <circle cx="150" cy="200" r="1" fill="white" opacity="0.6"/>
  <circle cx="700" cy="180" r="1.3" fill="white" opacity="0.8"/>
  <circle cx="500" cy="250" r="1" fill="white" opacity="0.7"/>
  <circle cx="320" cy="300" r="0.9" fill="white" opacity="0.6"/>
  <circle cx="650" cy="350" r="1.1" fill="white" opacity="0.7"/>
  <circle cx="180" cy="400" r="1" fill="white" opacity="0.6"/>
  <circle cx="450" cy="450" r="1.2" fill="white" opacity="0.8"/>
  <circle cx="720" cy="480" r="0.8" fill="white" opacity="0.5"/>
  <circle cx="280" cy="520" r="1" fill="white" opacity="0.7"/>
  <circle cx="550" cy="550" r="1.3" fill="white" opacity="0.8"/>
  
  <!-- Central glow -->
  <ellipse cx="400" cy="300" rx="200" ry="150" fill="url(#glowGradient)"/>
  
  <!-- Satellite icon -->
  <g transform="translate(400, 300)">
    <!-- Satellite body -->
    <rect x="-30" y="-20" width="60" height="40" fill="#6366f1" stroke="#8b5cf6" stroke-width="2" rx="4"/>
    
    <!-- Solar panels -->
    <rect x="-70" y="-15" width="35" height="30" fill="#3b82f6" stroke="#60a5fa" stroke-width="1.5" rx="2"/>
    <rect x="35" y="-15" width="35" height="30" fill="#3b82f6" stroke="#60a5fa" stroke-width="1.5" rx="2"/>
    
    <!-- Panel details -->
    <line x1="-70" y1="-10" x2="-35" y2="-10" stroke="#1e40af" stroke-width="0.5"/>
    <line x1="-70" y1="0" x2="-35" y2="0" stroke="#1e40af" stroke-width="0.5"/>
    <line x1="-70" y1="10" x2="-35" y2="10" stroke="#1e40af" stroke-width="0.5"/>
    <line x1="35" y1="-10" x2="70" y2="-10" stroke="#1e40af" stroke-width="0.5"/>
    <line x1="35" y1="0" x2="70" y2="0" stroke="#1e40af" stroke-width="0.5"/>
    <line x1="35" y1="10" x2="70" y2="10" stroke="#1e40af" stroke-width="0.5"/>
    
    <!-- Antenna -->
    <line x1="0" y1="-20" x2="0" y2="-45" stroke="#8b5cf6" stroke-width="2"/>
    <circle cx="0" cy="-45" r="4" fill="#a78bfa"/>
    
    <!-- Signal waves -->
    <path d="M 0,-45 Q -15,-55 -20,-70" stroke="#a78bfa" stroke-width="1.5" fill="none" opacity="0.6"/>
    <path d="M 0,-45 Q 15,-55 20,-70" stroke="#a78bfa" stroke-width="1.5" fill="none" opacity="0.6"/>
    
    <!-- Body details -->
    <circle cx="-10" cy="-5" r="3" fill="#4c1d95" opacity="0.6"/>
    <circle cx="10" cy="-5" r="3" fill="#4c1d95" opacity="0.6"/>
    <rect x="-20" y="5" width="40" height="3" fill="#4c1d95" opacity="0.4" rx="1"/>
  </g>
  
  <!-- Text -->
  <text x="400" y="420" font-family="Arial, sans-serif" font-size="24" fill="#8b5cf6" text-anchor="middle" font-weight="bold">
    Space Image Loading...
  </text>
  <text x="400" y="450" font-family="Arial, sans-serif" font-size="16" fill="#a78bfa" text-anchor="middle" opacity="0.8">
    Exploring the cosmos
  </text>
</svg>